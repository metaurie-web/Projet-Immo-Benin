// Schéma de la base de données.
// On décrit ici les « tables » (appelées « modèles ») et leurs colonnes.
// Après chaque modification de ce fichier : `npx prisma migrate dev`.
// Doc : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Une annonce de logement à louer.
model Listing {
  id           Int      @id @default(autoincrement())
  ref          String   @unique // référence publique, ex. "MA-1042"

  title        String
  city         String
  quartier     String
  type         String // "Chambre-salon" | "Appartement" | "Maison basse" | "Villa"
  price        Int // loyer mensuel, en FCFA
  rooms        Int
  furnished    Boolean
  meter        String // "individuel" | "partagé"
  water        String
  parking      Boolean
  advance      String
  deposit      String
  landmark     String
  description  String
  totalIn      Int // total à verser à l'entrée, en FCFA
  featured     Boolean  @default(false)
  publishedAt  String // libellé lisible ("il y a 3 jours") — deviendra une vraie date plus tard

  // Propriétaire : pour l'instant de simples champs texte.
  // Deviendra une relation vers un modèle `Owner` à l'étape authentification.
  owner        String
  ownerSince   String
  ownerCount   Int

  // Note moyenne + nombre d'avis (résumé affiché dans les listes).
  rating       String
  reviewsCount Int

  // Champs "liste" : SQLite ne gère pas les tableaux, on stocke du JSON.
  photos       Json // string[]  — libellés des photos
  costRows     Json // { k: string; v: string }[] — lignes du tableau "ce que vous payez"

  reviews      Review[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Un avis laissé par un visiteur sur une annonce.
model Review {
  id         Int      @id @default(autoincrement())
  listing    Listing  @relation(fields: [listingRef], references: [ref], onDelete: Cascade)
  listingRef String

  who        String
  when       String
  stars      String
  text       String

  createdAt  DateTime @default(now())
}

/* ------------------------------------------------------------------ */
/*  Authentification (Auth.js / next-auth, connexion par lien magique)  */
/*  Ces 4 modèles suivent le format attendu par @auth/prisma-adapter :  */
/*  https://authjs.dev/getting-started/adapters/prisma                 */
/* ------------------------------------------------------------------ */

/// Un utilisateur du site (propriétaire ou administrateur).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// "proprietaire" (par défaut) ou "admin".
  role          String    @default("proprietaire")

  accounts      Account[]
  sessions      Session[]

  createdAt     DateTime  @default(now())
}

/// Compte de connexion externe (non utilisé pour l'instant : on ne se
/// connecte que par lien magique — ce modèle prépare une future connexion
/// Google/Facebook si on en a besoin un jour).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Une session active (créée après un clic sur le lien magique).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Le code envoyé par email lors d'une connexion par lien magique.
/// Une ligne est créée à l'envoi, supprimée dès qu'elle est utilisée (ou expirée).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
