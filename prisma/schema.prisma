// Schéma de la base de données.
// On décrit ici les « tables » (appelées « modèles ») et leurs colonnes.
// Après chaque modification de ce fichier : `npx prisma migrate dev`.
// Doc : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL : connexion "pooled" (via pgbouncer), utilisée par
  // l'application au quotidien. DIRECT_URL : connexion directe, réservée
  // aux commandes `prisma migrate` — le pooling gêne les opérations de
  // schéma (verrous, transactions longues). Les deux pointent la même
  // base, Neon fournit les deux formes dans son tableau de bord.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Une annonce de logement à louer.
model Listing {
  id           Int      @id @default(autoincrement())
  ref          String   @unique // référence publique, ex. "MA-1042"

  title        String
  city         String
  quartier     String
  type         String // "Chambre-salon" | "Appartement" | "Maison basse" | "Villa"
  price        Int // loyer mensuel, en FCFA
  rooms        Int
  furnished    Boolean
  meter        String // "individuel" | "partagé"
  water        String
  parking      Boolean
  advance      String
  deposit      String
  landmark     String
  description  String
  totalIn      Int // total à verser à l'entrée, en FCFA
  featured     Boolean  @default(false)
  publishedAt  String // libellé lisible ("il y a 3 jours") — deviendra une vraie date plus tard

  /// Transaction KKiaPay (commission de publication) vérifiée côté serveur
  /// avant la création de cette ligne — voir src/lib/kkiapay.ts. Vide pour
  /// les annonces de démonstration, publiées avant ce paiement.
  transactionId String? @unique

  /// Cycle de vie d'une annonce :
  /// "en_attente" (déposée, pas encore contrôlée) → "en_ligne" (validée, visible
  /// publiquement) ou "correction_demandee" / "refusee". "expiree" plus tard.
  /// Les 12 annonces de démonstration restent "en_ligne" (valeur par défaut).
  status       String   @default("en_ligne")

  // Nom affiché du propriétaire sur l'annonce (texte libre, peut différer du
  // compte connecté — ex. "M. Adjovi Kossi" plutôt qu'un email).
  owner        String
  ownerSince   String
  ownerCount   Int

  // Compte propriétaire réellement connecté (optionnel : les annonces de
  // démonstration n'en ont pas). C'est lui qui détermine ce qui apparaît
  // dans /espace-proprietaire.
  ownerId      String?
  ownerAccount User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Note moyenne + nombre d'avis (résumé affiché dans les listes).
  rating       String
  reviewsCount Int

  // Champs "liste" : SQLite ne gère pas les tableaux, on stocke du JSON.
  photos       Json // string[]  — libellés des photos
  costRows     Json // { k: string; v: string }[] — lignes du tableau "ce que vous payez"

  reviews      Review[]
  favorites    Favorite[]
  visitSlots   VisitSlot[]
  visitRequests VisitRequest[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Un avis laissé par un visiteur sur une annonce.
model Review {
  id         Int      @id @default(autoincrement())
  listing    Listing  @relation(fields: [listingRef], references: [ref], onDelete: Cascade)
  listingRef String

  who        String
  when       String
  stars      String
  text       String

  createdAt  DateTime @default(now())
}

/* ------------------------------------------------------------------ */
/*  Authentification (Auth.js / next-auth, connexion par lien magique)  */
/*  Ces 4 modèles suivent le format attendu par @auth/prisma-adapter :  */
/*  https://authjs.dev/getting-started/adapters/prisma                 */
/* ------------------------------------------------------------------ */

/// Un utilisateur du site : visiteur, propriétaire ou administrateur.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// "visiteur" (par défaut, à l'inscription) | "proprietaire" | "admin".
  /// Un visiteur devient propriétaire automatiquement quand un admin valide
  /// sa vérification d'identité (voir moderateVerification()) — ou peut
  /// être promu manuellement depuis /admin/proprietaires.
  role          String    @default("visiteur")

  /// Vérification d'identité du propriétaire — faite UNE SEULE FOIS par
  /// compte, avant sa première publication. "non_verifie" (par défaut) |
  /// "en_attente" | "verifie" | "refuse". Une fois "verifie", il n'a plus
  /// besoin de repasser par là pour publier d'autres annonces.
  verificationStatus String    @default("non_verifie")
  identityDocUrl      String? // pièce d'identité, stockée dans un store Blob PRIVÉ
  verificationNote    String? // raison d'un refus, visible au propriétaire
  verifiedAt          DateTime?

  accounts      Account[]
  sessions      Session[]
  listings      Listing[]
  favorites     Favorite[]
  visitRequests VisitRequest[]

  createdAt     DateTime  @default(now())
}

/// Un bien mis en favori par un visiteur (ou un propriétaire — rien ne l'en
/// empêche). Une seule fois par personne et par bien.
model Favorite {
  id         Int      @id @default(autoincrement())
  userId     String
  listingRef String
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingRef], references: [ref], onDelete: Cascade)

  @@unique([userId, listingRef])
}

/// Un créneau que le propriétaire propose pour visiter CE bien (donc
/// rattaché à l'annonce, pas au compte : chaque bien a sa propre adresse).
model VisitSlot {
  id         Int      @id @default(autoincrement())
  listing    Listing  @relation(fields: [listingRef], references: [ref], onDelete: Cascade)
  listingRef String

  day        String // "Samedi"
  date       String // "12 sept."
  time       String // "09h00 – 09h30"

  createdAt  DateTime @default(now())
}

/// Une demande de visite déposée par un compte connecté sur un créneau.
model VisitRequest {
  id         Int      @id @default(autoincrement())
  listing    Listing  @relation(fields: [listingRef], references: [ref], onDelete: Cascade)
  listingRef String

  /// Libellé du créneau, figé au moment de la demande : reste lisible même
  /// si le propriétaire retire le créneau plus tard.
  slotLabel  String

  requester   User?   @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  requesterId String?
  name        String
  phone       String
  message     String?

  /// Transaction KKiaPay (200 FCFA) vérifiée côté serveur avant la
  /// création de cette ligne — voir src/lib/kkiapay.ts.
  transactionId String? @unique

  /// "en_attente" (par défaut) | "confirmee" | "refusee".
  status     String   @default("en_attente")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Réglages généraux du site — une seule ligne (id fixe "default").
model SiteSettings {
  id               String @id @default("default")
  commissionAmount Int    @default(5000) // FCFA, pour 30 jours de publication
}

/// Compte de connexion externe (non utilisé pour l'instant : on ne se
/// connecte que par lien magique — ce modèle prépare une future connexion
/// Google/Facebook si on en a besoin un jour).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Une session active (créée après un clic sur le lien magique).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Le code envoyé par email lors d'une connexion par lien magique.
/// Une ligne est créée à l'envoi, supprimée dès qu'elle est utilisée (ou expirée).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
