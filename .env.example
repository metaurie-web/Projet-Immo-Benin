# ---------------------------------------------------------------------------
# Modèle de variables d'environnement.
#
# Pour l'utiliser : copie ce fichier en « .env.local » (qui, lui, n'est jamais
# partagé ni committé) et remplis les valeurs.
#
#   Windows PowerShell :  Copy-Item .env.example .env.local
#
# Rien de tout ceci n'est encore branché — ces lignes préparent les étapes
# suivantes (base de données, envoi d'emails).
# ---------------------------------------------------------------------------

# Base de données (PostgreSQL via Prisma, étape suivante)
DATABASE_URL=

# Service d'envoi d'emails (ex. Resend)
RESEND_API_KEY=
EMAIL_FROM="Mon Appart <no-reply@exemple.bj>"

# URL publique du site (utile pour les liens dans les emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
