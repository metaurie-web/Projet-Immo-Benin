# ---------------------------------------------------------------------------
# Modèle de variables d'environnement.
#
# Pour l'utiliser : copie ce fichier en « .env » et remplis les valeurs.
# Le vrai « .env » n'est jamais partagé ni committé (voir .gitignore).
#
#   Windows PowerShell :  Copy-Item .env.example .env
#
# ---------------------------------------------------------------------------

# Base de données.
# En local : SQLite, un simple fichier dans prisma/.
DATABASE_URL="file:./dev.db"
# Plus tard, en production : une URL PostgreSQL, du genre
# DATABASE_URL="postgresql://user:motdepasse@hote:5432/mon_appart?schema=public"

# Authentification (next-auth) — connexion par lien magique.
# NEXTAUTH_SECRET : une chaîne aléatoire propre à chaque machine/environnement.
# Générer la tienne :  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# Service d'envoi d'emails (Resend). Optionnel en développement : tant que
# c'est vide, le lien de connexion s'affiche dans le terminal au lieu d'être
# envoyé pour de vrai. Clé gratuite sur https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Mon Appart <onboarding@resend.dev>"

# Stockage des photos (Vercel Blob). Optionnel en développement : tant que
# c'est vide, les annonces gardent leurs vignettes de démonstration au lieu
# de vraies photos. Jeton gratuit sur https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=

# URL publique du site (utile pour les liens dans les emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
