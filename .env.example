# ---------------------------------------------------------------------------
# Modèle de variables d'environnement.
#
# Pour l'utiliser : copie ce fichier en « .env » et remplis les valeurs.
# Le vrai « .env » n'est jamais partagé ni committé (voir .gitignore).
#
#   Windows PowerShell :  Copy-Item .env.example .env
#
# ---------------------------------------------------------------------------

# Base de données.
# En local : SQLite, un simple fichier dans prisma/.
DATABASE_URL="file:./dev.db"
# Plus tard, en production : une URL PostgreSQL, du genre
# DATABASE_URL="postgresql://user:motdepasse@hote:5432/mon_appart?schema=public"

# Authentification (next-auth) — connexion par lien magique.
# NEXTAUTH_SECRET : une chaîne aléatoire propre à chaque machine/environnement.
# Générer la tienne :  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# Service d'envoi d'emails (Brevo). Optionnel en développement : tant que
# c'est vide, le lien de connexion s'affiche dans le terminal au lieu d'être
# envoyé pour de vrai. Compte gratuit sur https://www.brevo.com — la clé se
# trouve dans SMTP & API > API Keys. EMAIL_FROM doit être une adresse déjà
# validée comme expéditeur (Senders, Domains & Dedicated IPs).
BREVO_API_KEY=
EMAIL_FROM="Mon Appart <votre-adresse-validee@exemple.com>"

# Stockage des photos (Vercel Blob) — store à accès PUBLIC. Optionnel en
# développement : tant que c'est vide, les annonces gardent leurs vignettes
# de démonstration au lieu de vraies photos. Jeton gratuit sur
# https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=

# Stockage des pièces d'identité (Vercel Blob) — store SÉPARÉ, à accès
# PRIVÉ (documents sensibles, jamais publics). Tant que c'est vide, la
# vérification d'identité reste indisponible.
BLOB_PRIVATE_READ_WRITE_TOKEN=

# URL publique du site (utile pour les liens dans les emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paiement Mobile Money (KKiaPay) — demandes de visite et commission de
# publication. Compte gratuit sur https://kkiapay.me, clés dans le
# tableau de bord (Développeurs). Tant que les clés sont vides, les
# formulaires concernés restent inutilisables (le paiement est requis).
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY=
NEXT_PUBLIC_KKIAPAY_SANDBOX=true
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
